# Kopieer naar .env en vul in. Commit .env NOOIT.
# JWT_SECRET: minstens 32 willekeurige tekens, genereer met:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# DEMO_PASSWORD: minstens 8 tekens, wachtwoord voor alle demo-accounts
DEMO_PASSWORD=
# Optioneel: zonder key gebruikt de app standaardteksten
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
